PORT=4000
REDIS_URL=redis://localhost:6380

# Storefront origin: used for CORS and DOKU's return URLs. On Vercel it defaults to the
# production domain (or the preview URL), so only set it to override.
WEB_ORIGIN=http://localhost:3000

# Shared secret the CMS uses to push catalog + stock to POST /internal/sync.
INTERNAL_SECRET=change-me-internal

# "mock" = no real payment, orders are confirmed instantly (local dev + load tests).
# "doku" = DOKU Checkout hosted page (QRIS, e-wallets, virtual accounts, cards).
PAYMENTS_MODE=mock
DOKU_ENV=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# Notification route, relative to /api. Notification URL in the DOKU back office:
# https://<your-domain>/api/webhooks/doku. /api + this path is part of the signature.
DOKU_NOTIFY_PATH=/webhooks/doku
# Optional, comma-separated. Empty = every method enabled on your DOKU account.
# e.g. QRIS,EMONEY_SHOPEE_PAY,EMONEY_OVO,EMONEY_DANA,VIRTUAL_ACCOUNT_BCA,VIRTUAL_ACCOUNT_BANK_MANDIRI,CREDIT_CARD
DOKU_PAYMENT_METHODS=

# Flat shipping fee in rupiah added to every order (0 = free shipping).
SHIPPING_FEE=0

# Stock hold = DOKU payment page lifetime. Short = fairer drops.
HOLD_MINUTES=10
# Extra wait for late DOKU notifications before checking status and releasing stock.
PAYMENT_GRACE_MINUTES=3
# Give up on a still-"pending" payment after this long and put the units back on sale.
PAYMENT_MAX_WAIT_MINUTES=30

# Checkout attempts per IP per minute.
RATE_LIMIT_PER_MIN=10
# Set to 1 behind a CDN / load balancer so the real client IP is read from headers (defaults to 1 on Vercel).
TRUST_PROXY=0
