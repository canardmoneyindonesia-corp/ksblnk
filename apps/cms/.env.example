PORT=3001
DATABASE_URL=postgres://kskblnk:kskblnk@localhost:55432/cms
PAYLOAD_SECRET=change-me-long-random-string
# Public origin of this CMS (absolute media URLs). Admin: <origin>/cms/admin.
# On Vercel leave it unset (media URLs stay relative, same domain) or set your domain.
CMS_PUBLIC_URL=http://localhost:3001

# Base URL of the API service (calls <API_URL>/api/internal/...) - secret must match INTERNAL_SECRET there.
# On Vercel do NOT set API_URL: it is a service binding, injected at runtime.
API_URL=http://localhost:4000
API_INTERNAL_SECRET=change-me-internal

# Base URL of the storefront (calls <WEB_URL>/api/revalidate) - must match REVALIDATE_SECRET in apps/web.
# On Vercel it is optional: defaults to the deployment's public URL (production domain or preview URL).
WEB_URL=http://localhost:3000
WEB_REVALIDATE_SECRET=change-me-revalidate

# How often (seconds) to pull new paid orders from the API into the Orders list. 0 = off.
ORDER_IMPORT_INTERVAL_SECONDS=30
