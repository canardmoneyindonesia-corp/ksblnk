# Server-side only: base URL of the CMS service (products are read from <CMS_URL>/cms/api).
# On Vercel do NOT set it: it is the `cms` service binding, injected at runtime.
CMS_URL=http://localhost:3001
# Vercel only, optional: public site URL (e.g. https://your-domain) the build pre-renders
# products from, since bindings don't exist during `next build`. Unset = build with no
# products; ISR / CMS revalidation fill them in at runtime.
# CMS_BUILD_URL=
# Browser: live stock + checkout. On Vercel leave it unset: the API is at /api on the same domain.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Must match WEB_REVALIDATE_SECRET in apps/cms.
REVALIDATE_SECRET=change-me-revalidate
# Adobe Fonts web project id (Adobe Kis + Acroterion JF), e.g. abc1def -> use.typekit.net/abc1def.css
NEXT_PUBLIC_ADOBE_FONTS_KIT=
