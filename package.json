{
  "name": "kskblnk",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "seed": "pnpm --filter @kskblnk/cms seed",
    "drop:sim": "pnpm --filter @kskblnk/api drop:sim"
  },
  "devDependencies": {
    "turbo": "^2.11.12",
    "typescript": "5.7.3"
  }
}
